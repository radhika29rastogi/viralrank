NEXT_PUBLIC_SITE_URL=https://viralrank.buzz

# Supabase (required for creator submissions, auth, rankings)
# Project Settings → API in https://supabase.com/dashboard
# Project URL only: https://<ref>.supabase.co (do NOT paste the /rest/v1 REST endpoint)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for POST /api/creators (never NEXT_PUBLIC_, never commit)
SUPABASE_SERVICE_ROLE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Webhooks (server-only; falls back to RAZORPAY_KEY_SECRET)
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional Cloudflare Turnstile (creator submission)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
