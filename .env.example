# =============================================================================
# ViralRank.buzz environment variables
# Copy to .env.local for local development. Never commit .env or .env.local.
# Add the same names in Vercel → Project Settings → Environment Variables
# (Production + Preview). Do not put secrets in NEXT_PUBLIC_* variables.
# =============================================================================

# --- Public site (required) ---
# Canonical public origin used for Open Graph / metadata.
# Production is served on www (apex 308s to www). Use the host users see.
NEXT_PUBLIC_SITE_URL=https://www.viralrank.buzz

# --- Supabase (required for listings, rankings, visits) ---
# Project Settings → API in https://supabase.com/dashboard
# Project URL only: https://<ref>.supabase.co  (do NOT paste /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key — public, used in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for POST /api/creators, payments, admin, uploads.
# Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# No signup/login. Do not add auth redirect URLs for product flows.
# Optional moderation: /admin?key=ADMIN_SECRET
ADMIN_SECRET=

# Instagram profile lookup — server only, never NEXT_PUBLIC_*.
# RapidAPI Instagram Looter: "User info by username" (GET /profile?username=).
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-looter2.p.rapidapi.com
# Legacy alias still read if RAPIDAPI_HOST is empty
RAPIDAPI_INSTAGRAM_HOST=

# Optional receipt + magic manage-link email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Razorpay (required for rank bid / hype / Standard Checkout) ---
# Dashboard → Account & Settings → API Keys — matching Key ID + Key Secret pair
# Also supported in gitignored `.env`. Next.js prefers `.env.local` when both exist.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must equal RAZORPAY_KEY_ID — used only to open Razorpay Checkout in the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Webhook secret from Razorpay Dashboard → Webhooks
# Required in production. Without it, /api/webhooks/razorpay rejects every event.
RAZORPAY_WEBHOOK_SECRET=

# --- Cron (daily 8:00 PM IST battle winner) ---
# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/daily-battle
# Schedule in vercel.json: 30 14 * * * (20:00 IST).
CRON_SECRET=

# --- Cloudflare Turnstile (optional — leave BOTH empty unless the widget is on /submit) ---
# If either key is set, POST /api/creators requires a token and submissions will fail
# until a client widget is added. Do not set these for launch unless the widget exists.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
