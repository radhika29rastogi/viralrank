NEXT_PUBLIC_SITE_URL=https://viralrank.buzz

# Supabase (required for creator submissions, auth, rankings)
# Project Settings → API in https://supabase.com/dashboard
# Project URL only: https://<ref>.supabase.co (do NOT paste the /rest/v1 REST endpoint)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for POST /api/creators (never NEXT_PUBLIC_, never commit)
SUPABASE_SERVICE_ROLE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---------------------------------------------------------------------------
# Meta Instagram Graph API — Business Discovery (server-only)
# Never use NEXT_PUBLIC_ for these. Never commit real tokens.
#
# Product requirement: look up OTHER professional Instagram accounts by username.
# That requires Instagram API with Facebook Login + Business Discovery on
# graph.facebook.com — NOT Instagram Login (graph.instagram.com).
#
# Required:
#   INSTAGRAM_ACCESS_TOKEN         Long-lived Facebook User access token
#   INSTAGRAM_BUSINESS_ACCOUNT_ID  Your professional IG User id (caller account)
#
# Optional:
#   INSTAGRAM_CLIENT_SECRET        If set, requests include appsecret_proof
#   INSTAGRAM_GRAPH_API_VERSION    Defaults to v21.0 (Meta samples also use v25.0)
#
# Unused by fetch code (do not put App ID here unless you add OAuth later):
#   INSTAGRAM_CLIENT_ID
# ---------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_CLIENT_SECRET=

# Optional Cloudflare Turnstile (creator submission)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
